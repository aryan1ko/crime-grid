# Get a free Census API key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# Austin Open Data — no key required for public datasets, but a token raises rate limits
# Register free at: https://data.austintexas.gov/profile/app_tokens
SOCRATA_APP_TOKEN=your_socrata_token_here

# Output directory for raw data files
DATA_DIR=./data

# DuckDB database path
DB_PATH=./data/austin_crime.duckdb
